# ============================================================
# TurSathi AI Backend — Production Dockerfile Example
# ============================================================

FROM python:3.11-slim

# Install system libraries required by OpenCV headless and image decoders
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copy backend application code
COPY backend/app ./app
COPY backend/alembic ./alembic
COPY backend/alembic.ini ./

# Copy required production ML checkpoints
COPY models/best_pigeonpea_disease_final_efficientnet_b0.pth ./models/
COPY models/tur_image_validator_efficientnet_b0_v3.pth ./models/

# Expose standard API port
EXPOSE 8000

# Production startup using Uvicorn
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
