# ============================================================
# TurSathi AI Backend — Environment Configuration Template
# ============================================================

# Environment Mode ('development' or 'production')
ENVIRONMENT=development
DEBUG=True

# Security & JWT Configuration
# In production, generate a secure random key: openssl rand -hex 32
SECRET_KEY=your_secure_random_secret_key_here
API_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated HTTPS URLs for production)
# In development, localhost and LAN IPs are automatically permitted.
# In production, specify exact allowed frontend origins, e.g.:
# FRONTEND_CORS_ORIGINS=https://tursathi.yourdomain.com,https://api.yourdomain.com
FRONTEND_CORS_ORIGINS=http://localhost:8081,http://localhost:5173,http://localhost:8000

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
POSTGRES_DB=tursathi_db

# Optional Direct Database URL Override (e.g. for Render/Railway/Supabase/RDS)
# SQLALCHEMY_DATABASE_URI=postgresql://user:password@host:5432/dbname

# Anthropic Claude API (Optional; for dynamic multilingual agronomic advice)
# If omitted, system seamlessly uses verified local agronomic database guidance.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Google OAuth Configuration (Optional)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Email / SMTP Configuration for Password Recovery (Optional in dev, required in prod)
# Preferred provider: Gmail SMTP with a generated App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_verified_sender@gmail.com
SMTP_PASSWORD=your_new_app_password
SMTP_FROM_EMAIL=your_verified_sender@gmail.com
SMTP_FROM_NAME="TurSathi AI"
SMTP_TLS=True

# Feature Flags
ENABLE_ORGAN_VALIDATOR=False

