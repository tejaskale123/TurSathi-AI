# ==============================================================================
# TurSathi AI — Comprehensive Production .gitignore
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment & Secrets (Raw VPS Defense & Credential Leakage Prevention)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
**/.env
**/.env.*
!*.env.example
!*.env.docker.example
!.env.example
!.env.docker.example

# Private / Public Keys, Certificates, and Tokens
*.pem
*.key
*.p12
*.p8
*.crt
*.csr
*.der
*.jks
*.keystore
*.mobileprovision
*.pub
id_rsa*
id_ed25519*
secrets.json
credentials.json
client_secret*.json
service-account*.json

# ------------------------------------------------------------------------------
# 2. Python Runtime, Bytecode & Package Artifacts
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib
.Python
build/
dist/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.spec

# Virtual Environments
venv/
.venv/
env/
ENV/
.env.virtual/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt
.pip-cache/

# Testing, Coverage & Linters
.tox/
.nox/
.cache/
.pytest_cache/
**/.pytest_cache/
pytestdebug.log
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
cover/
htmlcov/
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pyre/
.pytype/

# Jupyter / IPython
.ipynb_checkpoints/
*-checkpoint.ipynb
.jupyter/

