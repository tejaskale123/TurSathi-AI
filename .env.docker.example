# ============================================================
# TurSathi AI — Production Cloud Environment Configuration
# Copy this to .env on your cloud host before running:
# docker compose up -d --build
# ============================================================

# Environment & Debug (Always False in production)
ENVIRONMENT=production
DEBUG=False

# VPS Performance Tuning (Optimized for 4-Core VPS with limited RAM)
# 2 workers * 2 PyTorch threads = 4 cores utilized without thrashing or multiplying model memory 4x
WEB_CONCURRENCY=2
TORCH_NUM_THREADS=2

# PostgreSQL Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_strong_database_password_here
POSTGRES_DB=tursathi_db
POSTGRES_PORT=5432

# Application JWT Secret (Generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_random_64_character_hex_secret_key_here

# Anthropic Claude 4.5 API (for AI Agricultural Guidance & Voice Advisory)
ANTHROPIC_API_KEY=your_production_anthropic_api_key_here
ANTHROPIC_MODEL=claude-sonnet-4-5-20250929

# Sarvam AI Indic Speech-to-Text Configuration
SARVAM_API_KEY=your_production_sarvam_api_key_here
SARVAM_STT_MODEL=saaras:v4

# Test & Diagnostic Endpoints (Keep False in production to protect paid API quota)
ENABLE_TEST_ENDPOINTS=False

# Frontend / Mobile CORS (Allowing mobile APK & web clients)
FRONTEND_CORS_ORIGINS=http://localhost:8081,http://localhost:8000
