# ============================================================
# TurSathi AI Mobile (Expo / React Native) — Environment Template
# ============================================================

# Production Backend API URL
# In development, Expo dynamically resolves laptop LAN IP if this is omitted.
# In production, set this to your hosted backend URL (WITHOUT trailing slash):
# Raw VPS port 7066 is exposed over plain HTTP (no reverse-proxy TLS) —
# app.json already sets android.usesCleartextTraffic=true to permit this.
EXPO_PUBLIC_API_URL=http://88.222.212.15:7066

# Must match the backend's API_KEY exactly (sent as the X-API-Key header)
EXPO_PUBLIC_API_KEY=your_production_api_key_here
