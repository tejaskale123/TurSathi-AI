# ============================================================
# TurSathi AI Mobile (Expo / React Native) — Environment Template
# ============================================================

# Production Backend API URL (HTTPS)
# In development, Expo dynamically resolves laptop LAN IP if this is omitted.
# In production, set this to your hosted backend HTTPS URL (WITHOUT trailing slash):
# Example: EXPO_PUBLIC_API_URL=https://api.tursathi.yourdomain.com
EXPO_PUBLIC_API_URL=https://api.yourdomain.com
